{
  "name": "skills-bank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Central registry of Claude Code skills with TypeScript CLI and Electron desktop manager.",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "validate": "tsx scripts/validate-all.ts",
    "build:index": "tsx scripts/build-index.ts",
    "cli": "node packages/cli/dist/index.js",
    "desktop:dev": "pnpm --filter @skills-bank/desktop dev",
    "desktop:build": "pnpm --filter @skills-bank/desktop build"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
