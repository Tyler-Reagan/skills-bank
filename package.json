{
  "name": "skills-bank",
  "version": "1.20.5",
  "private": true,
  "type": "module",
  "description": "Central registry of Claude Code skills with TypeScript CLI and Electron desktop manager.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "pnpm --filter @skills-bank/desktop dev",
    "start": "pnpm --filter @skills-bank/desktop start",
    "build": "pnpm -r --if-present run build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,mdx,json,yml,yaml}\" --cache",
    "docs:dev": "pnpm --filter @skills-bank/docs dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "validate": "tsx scripts/validate-all.ts",
    "build:index": "tsx scripts/build-index.ts",
    "docs:check": "node scripts/check-doc-links.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,mdx,json,yml,yaml}\" --cache",
    "knip": "knip",
    "reset": "tsx scripts/reset-dev-fresh.ts",
    "bank": "tsx scripts/bank.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "knip": "^6.13.1",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
