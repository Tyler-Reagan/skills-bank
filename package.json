{
  "name": "skills-bank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Central registry of Claude Code skills with TypeScript CLI and Electron desktop manager.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "validate": "tsx scripts/validate-all.ts",
    "build:index": "tsx scripts/build-index.ts",
    "cli": "node packages/cli/dist/index.js",
    "desktop:dev": "pnpm --filter @skills-bank/desktop dev",
    "desktop:build": "pnpm --filter @skills-bank/desktop build",
    "desktop:start": "pnpm --filter @skills-bank/desktop start",
    "desktop:package:mac": "pnpm --filter @skills-bank/desktop package:mac",
    "desktop:package:win": "pnpm --filter @skills-bank/desktop package:win",
    "desktop:reset": "tsx scripts/reset-desktop-config.ts",
    "desktop:reset:hard": "tsx scripts/reset-desktop-config.ts --hard",
    "docs:check": "node scripts/check-doc-links.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
