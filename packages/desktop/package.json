{
  "name": "@skills-bank/desktop",
  "version": "1.22.2",
  "private": true,
  "type": "module",
  "description": "Desktop manager for skills-bank",
  "main": "dist-main/main/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:preload": "esbuild src/main/preload.mts --bundle --platform=node --format=cjs --external:electron --target=node20 --outfile=dist-main/main/preload.cjs",
    "build:main": "tsc -b tsconfig.main.json && pnpm run build:preload",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "dev": "pnpm run build:main && vite build --watch & sleep 1 && env -u ELECTRON_RUN_AS_NODE SKILLS_BANK_DEVTOOLS=1 electron .",
    "start": "pnpm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "typecheck": "tsc -b tsconfig.main.json && tsc -p tsconfig.json --noEmit",
    "icons": "bash scripts/build-icons.sh"
  },
  "dependencies": {
    "@skills-bank/core": "workspace:*",
    "dompurify": "^3.2.4",
    "electron-updater": "^6.3.9",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.tyler-reagan.skills-bank",
    "productName": "Skills Bank",
    "artifactName": "Skills-Bank-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../docs/self-host.md",
        "to": "docs/self-host.md"
      },
      {
        "from": "../../skills",
        "to": "seed/skills"
      },
      {
        "from": "../../index.json",
        "to": "seed/index.json"
      }
    ],
    "asar": true,
    "asarUnpack": [],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "dmg": {
      "background": null,
      "writeUpdateInfo": true,
      "title": "${productName} ${version}"
    },
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "Tyler-Reagan",
      "repo": "skills-bank",
      "releaseType": "draft"
    }
  }
}
