{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-main",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "composite": true,
    "tsBuildInfoFile": "dist-main/.tsbuildinfo"
  },
  "include": ["src/main/**/*", "src/shared/**/*"],
  "references": [{ "path": "../core" }]
}
