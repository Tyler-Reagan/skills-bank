#!/usr/bin/env bash
# skills-bank-full-reset
#
# Full reset: app state + agent-sink symlinks. Skills will temporarily
# disappear from Claude Code / Cursor until you re-install them via the app.
#
# Deletes:
#   $HOME/Library/Application Support/@skills-bank/   (mac packaged + legacy-dev userData)
#   $HOME/Library/Application Support/Skills Bank/    (mac, alternate productName)
#   $HOME/.config/@skills-bank/                       (linux packaged userData)
#   $HOME/.config/Skills Bank/                        (linux, alternate productName)
#   $HOME/.skills-bank-dev/                           (current pnpm dev userData + dev sinks)
#   Symlinks in $HOME/.claude/skills/ and $HOME/.cursor/skills/ whose target
#   path contains 'skills-bank/skills/' or '.agents/skills/'.
#
# Preserves:
#   Non-symlink files in agent sinks (*.zip, .DS_Store)
#   Unrelated user-created symlinks in agent sinks (target doesn't match)
#   $HOME/.agents/                      -> deployed registry content
#   The source tree in any skills-bank checkout
#
# Post-run: launch the app, sign in / pick a registry source, re-install skills.

set -euo pipefail

if pgrep -fl "Skills Bank" >/dev/null 2>&1; then
  echo "Refusing to run: Skills Bank app appears to be running." >&2
  echo "Quit the app and re-run." >&2
  exit 1
fi

paths=(
  "$HOME/Library/Application Support/@skills-bank"
  "$HOME/Library/Application Support/Skills Bank"
  "$HOME/.config/@skills-bank"
  "$HOME/.config/Skills Bank"
  "$HOME/.skills-bank-dev"
)

sink_dirs=(
  "$HOME/.claude/skills"
  "$HOME/.cursor/skills"
)

# Print one path per line of symlinks-to-remove in $1.
collect_symlinks() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  find "$dir" -maxdepth 1 -type l 2>/dev/null | while IFS= read -r link; do
    local target
    target=$(readlink "$link")
    case "$target" in
      *skills-bank/skills/*|*.agents/skills/*) printf '%s\n' "$link" ;;
    esac
  done
}

existing_paths=()
for p in "${paths[@]}"; do
  [[ -e "$p" ]] && existing_paths+=("$p")
done

# Snapshot the symlink list once so the preview matches the action.
symlinks=()
for dir in "${sink_dirs[@]}"; do
  while IFS= read -r link; do
    [[ -n "$link" ]] && symlinks+=("$link")
  done < <(collect_symlinks "$dir")
done

if [[ ${#existing_paths[@]} -eq 0 && ${#symlinks[@]} -eq 0 ]]; then
  echo "Nothing to do: no Skills Bank userData and no matching symlinks found."
  exit 0
fi

echo "About to delete app state:"
if [[ ${#existing_paths[@]} -eq 0 ]]; then
  echo "  (none)"
else
  for p in "${existing_paths[@]}"; do
    size=$(du -sh "$p" 2>/dev/null | cut -f1)
    echo "  - $p  ($size)"
  done
fi

echo
echo "About to remove these skill symlinks:"
if [[ ${#symlinks[@]} -eq 0 ]]; then
  echo "  (none)"
else
  for link in "${symlinks[@]}"; do
    echo "  - $link  ->  $(readlink "$link")"
  done
fi

echo
read -r -p "Proceed? [y/N] " ans
case "$ans" in
  y|Y|yes|YES) ;;
  *) echo "Aborted."; exit 0 ;;
esac

for p in "${existing_paths[@]}"; do
  rm -rf "$p"
  echo "Removed: $p"
done

for link in "${symlinks[@]}"; do
  rm "$link"
  echo "Unlinked: $link"
done

echo
echo "Done. Launch Skills Bank, sign in / pick a registry, and re-install skills."
