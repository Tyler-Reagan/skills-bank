#!/usr/bin/env bash
# skills-bank-partial-reset
#
# Reset Skills Bank app state to a fresh-install feel while keeping skills
# already discoverable by Claude Code / Cursor.
#
# Deletes:
#   $HOME/Library/Application Support/@skills-bank/   (mac packaged + legacy-dev userData)
#   $HOME/Library/Application Support/Skills Bank/    (mac, alternate productName)
#   $HOME/.config/@skills-bank/                       (linux packaged userData)
#   $HOME/.config/Skills Bank/                        (linux, alternate productName)
#   $HOME/.skills-bank-dev/                           (current pnpm dev userData + dev sinks)
#
# Preserves:
#   $HOME/.claude/skills/*    symlinks  -> Claude Code keeps discovering skills
#   $HOME/.cursor/skills/*    symlinks
#   $HOME/.agents/                      -> deployed registry content
#   The source tree in any skills-bank checkout
#
# Post-run: app boots at LoginScreen with no GitHub auth and no registry source
# choice. Pre-existing symlinks in ~/.claude/skills/ will be auto-detected as
# 'Installed' in the registry browse view once a source is picked again.

set -euo pipefail

if pgrep -fl "Skills Bank" >/dev/null 2>&1; then
  echo "Refusing to run: Skills Bank app appears to be running." >&2
  echo "Quit the app and re-run." >&2
  exit 1
fi

paths=(
  "$HOME/Library/Application Support/@skills-bank"
  "$HOME/Library/Application Support/Skills Bank"
  "$HOME/.config/@skills-bank"
  "$HOME/.config/Skills Bank"
  "$HOME/.skills-bank-dev"
)

existing=()
for p in "${paths[@]}"; do
  [[ -e "$p" ]] && existing+=("$p")
done

if [[ ${#existing[@]} -eq 0 ]]; then
  echo "Nothing to do: no Skills Bank userData found on this machine."
  exit 0
fi

echo "About to delete:"
for p in "${existing[@]}"; do
  size=$(du -sh "$p" 2>/dev/null | cut -f1)
  echo "  - $p  ($size)"
done

echo
read -r -p "Proceed? [y/N] " ans
case "$ans" in
  y|Y|yes|YES) ;;
  *) echo "Aborted."; exit 0 ;;
esac

for p in "${existing[@]}"; do
  rm -rf "$p"
  echo "Removed: $p"
done

echo
echo "Done. Launch Skills Bank to see a fresh-install LoginScreen."
echo "Existing ~/.claude/skills/ symlinks were preserved."
